/coverage.*

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin
testbin/*

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.out.no-mocks

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
*.swp
*.swo
*~
*.DS_Store
.vscode

# Credentials and runtime environment
kubeconfig
.env

# Generated Ansible files (contain secrets)
ds-postgresql-values.yaml
entity-store-db-values.yaml
customizer-postgresql-values.yaml
customizer-opentelemetry-values.yaml
mlflow.yaml
volcano-oc-rbac.yaml
jupyter-ocp-rbac.yaml
secrets.yaml

# Environment-specific configuration (documented in README with placeholders)
values.yaml

# e2e logs
e2e_logs
